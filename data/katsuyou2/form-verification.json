    "minna-shokyu-1-group-1-059": {"dictionary":"なおる","kanji":"治る","confidence":"high","sources":[{"type":"dictionary-entry","name":"国立国語研究所 基本動詞ハンドブック 直る・治る","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"なおらなかった"},"potential":{"status":"not_applicable","note":"治る already expresses recovery or a change into a restored state; なおれる is not treated as its ordinary potential in this beginner curriculum."},"ba":{"status":"valid","value":"なおれば"},"volitional":{"status":"not_applicable","note":"Recovery is not normally a directly willed action. The beginner-intention meaning is taught with the transitive 治す and なおそう instead."},"causative":{"status":"deferred","note":"なおらせる can be constructed, but ordinary beginner contexts strongly prefer the transitive 治す. Excluded from production by user decision to avoid teaching a contrived form."}}},
    "minna-shokyu-1-group-1-060": {"dictionary":"なくす","kanji":"失くす","confidence":"high","sources":[{"type":"dictionary-entry","name":"国立国語研究所 基本動詞ハンドブック 無くす・亡くす","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"なくさなかった"},"potential":{"status":"deferred","note":"For the textbook sense 失くす 'misplace', なくせる is easily interpreted as 無くせる 'can eliminate'. Reserve it for a separate lexical item."},"ba":{"status":"valid","value":"なくせば","note":"Use an explicit possession such as a wallet or key so the conditional retains the misplacement sense."},"volitional":{"status":"deferred","note":"なくそう ordinarily expresses an intention to eliminate something, not an intention to misplace it. Reserve it for 無くす as a separate lexical item."},"causative":{"status":"deferred","note":"A beginner example for 失くさせる is likely to be contrived or to drift toward the elimination sense. Reserve it for later contextual review."}}},
    "minna-shokyu-1-group-1-061": {"dictionary":"ならう","kanji":"習う","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"ならわなかった"},"potential":{"status":"valid","value":"ならえる"},"ba":{"status":"valid","value":"ならえば"},"volitional":{"status":"valid","value":"ならおう"},"causative":{"status":"valid","value":"ならわせる"}}},
    "minna-shokyu-1-group-1-062": {"dictionary":"なる","kanji":"なる","confidence":"high","sources":[{"type":"dictionary-entry","name":"国立国語研究所 基本動詞ハンドブック なる","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"ならなかった"},"potential":{"status":"valid","value":"なれる"},"ba":{"status":"valid","value":"なれば"},"volitional":{"status":"valid","value":"なろう"},"causative":{"status":"valid","value":"ならせる","note":"Use an explicit causer and person assigned a role so it is not confused with 鳴らせる."}}},
    "minna-shokyu-1-group-1-063": {"dictionary":"ぬぐ","kanji":"脱ぐ","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"ぬがなかった"},"potential":{"status":"valid","value":"ぬげる"},"ba":{"status":"valid","value":"ぬげば"},"volitional":{"status":"valid","value":"ぬごう"},"causative":{"status":"valid","value":"ぬがせる"}}},
    "minna-shokyu-1-group-1-064": {"dictionary":"のぼる","kanji":"登る","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"のぼらなかった"},"potential":{"status":"valid","value":"のぼれる"},"ba":{"status":"valid","value":"のぼれば"},"volitional":{"status":"valid","value":"のぼろう"},"causative":{"status":"valid","value":"のぼらせる"}}},
    "minna-shokyu-1-group-1-065": {"dictionary":"のむ（くすりを）","kanji":"飲む（薬を）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"のまなかった"},"potential":{"status":"valid","value":"のめる"},"ba":{"status":"valid","value":"のめば"},"volitional":{"status":"valid","value":"のもう"},"causative":{"status":"valid","value":"のませる"}}},
    "minna-shokyu-1-group-1-066": {"dictionary":"のる","kanji":"乗る","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"のらなかった"},"potential":{"status":"valid","value":"のれる"},"ba":{"status":"valid","value":"のれば"},"volitional":{"status":"valid","value":"のろう"},"causative":{"status":"valid","value":"のらせる"}}},
    "minna-shokyu-1-group-1-067": {"dictionary":"はいる（だいがくに）","kanji":"入る（大学に）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"はいらなかった"},"potential":{"status":"valid","value":"はいれる"},"ba":{"status":"valid","value":"はいれば"},"volitional":{"status":"valid","value":"はいろう"},"causative":{"status":"valid","value":"はいらせる","note":"Keep the university-enrollment meaning explicit and identify the person who arranges or requires enrollment."}}},
    "minna-shokyu-1-group-1-068": {"dictionary":"はいる（きっさてんに）","kanji":"入る（喫茶店に）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"はいらなかった"},"potential":{"status":"valid","value":"はいれる"},"ba":{"status":"valid","value":"はいれば"},"volitional":{"status":"valid","value":"はいろう"},"causative":{"status":"valid","value":"はいらせる","note":"Keep the cafe-entry meaning explicit and identify the staff and customers in causative examples."}}},
    "minna-shokyu-1-group-1-069": {"dictionary":"はく","kanji":"履く","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"はかなかった"},"potential":{"status":"valid","value":"はける","note":"Keep shoes, socks, or trousers explicit so the form is not confused with 吐ける."},"ba":{"status":"valid","value":"はけば"},"volitional":{"status":"valid","value":"はこう"},"causative":{"status":"valid","value":"はかせる"}}},
    "minna-shokyu-1-group-1-070": {"dictionary":"はたらく","kanji":"働く","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"はたらかなかった"},"potential":{"status":"valid","value":"はたらける"},"ba":{"status":"valid","value":"はたらけば"},"volitional":{"status":"valid","value":"はたらこう"},"causative":{"status":"valid","value":"はたらかせる","note":"Identify the manager, worker, and workplace role so the causative relation is explicit."}}},
    "minna-shokyu-1-group-1-071": {"dictionary":"ひく","kanji":"弾く","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"ひかなかった"},"potential":{"status":"valid","value":"ひける","note":"Keep the instrument explicit so the form is not confused with other verbs read ひける."},"ba":{"status":"valid","value":"ひけば"},"volitional":{"status":"valid","value":"ひこう"},"causative":{"status":"valid","value":"ひかせる"}}},
    "minna-shokyu-1-group-1-072": {"dictionary":"ふる（あめが）","kanji":"降る（雨が）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"ふらなかった"},"potential":{"status":"not_applicable","note":"Weather is not normally expressed as having the ability to rain; ふれる is excluded from this beginner curriculum by user decision."},"ba":{"status":"valid","value":"ふれば"},"volitional":{"status":"not_applicable","note":"Rain has no intention, so ふろう is not taught as an ordinary volitional form in this curriculum."},"causative":{"status":"valid","value":"ふらせる","note":"Use an explicit artificial-rain context with a machine or human intervention."}}},
    "minna-shokyu-1-group-1-073": {"dictionary":"まがる","kanji":"曲がる","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"まがらなかった"},"potential":{"status":"valid","value":"まがれる","note":"Use an explicit road and vehicle context so the potential meaning is clear."},"ba":{"status":"valid","value":"まがれば"},"volitional":{"status":"valid","value":"まがろう"},"causative":{"status":"valid","value":"まがらせる"}}},
    "minna-shokyu-1-group-1-074": {"dictionary":"まわす","kanji":"回す","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"まわさなかった"},"potential":{"status":"valid","value":"まわせる","note":"Keep the handle, knob, or other rotating object explicit."},"ba":{"status":"valid","value":"まわせば"},"volitional":{"status":"valid","value":"まわそう"},"causative":{"status":"valid","value":"まわさせる"}}},
    "minna-shokyu-1-group-1-075": {"dictionary":"もつ","kanji":"持つ","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"もたなかった"},"potential":{"status":"valid","value":"もてる","note":"Keep a physical object explicit so the form is not confused with the lexical expression モテる."},"ba":{"status":"valid","value":"もてば"},"volitional":{"status":"valid","value":"もとう"},"causative":{"status":"valid","value":"もたせる"}}},
    "minna-shokyu-1-group-1-077": {"dictionary":"もらう","kanji":"貰う","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"もらわなかった"},"potential":{"status":"valid","value":"もらえる"},"ba":{"status":"valid","value":"もらえば"},"volitional":{"status":"valid","value":"もらおう"},"causative":{"status":"valid","value":"もらわせる","note":"Identify the person arranging the receipt and the recipient so the causative relation is explicit."}}},
    "minna-shokyu-1-group-1-078": {"dictionary":"やくにたつ","kanji":"役に立つ","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"やくにたたなかった"},"potential":{"status":"valid","value":"やくにたてる","note":"Use an animate subject and a clear beneficiary so the potential meaning is natural."},"ba":{"status":"valid","value":"やくにたてば"},"volitional":{"status":"valid","value":"やくにたとう"},"causative":{"status":"deferred","note":"The formally generated やくにたたせる is uncommon in ordinary beginner contexts, which normally use the lexical transitive verb 役立てる. Excluded from production by user decision."}}},
    "minna-shokyu-1-group-1-079": {"dictionary":"やすむ","kanji":"休む","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"やすまなかった"},"potential":{"status":"valid","value":"やすめる"},"ba":{"status":"valid","value":"やすめば"},"volitional":{"status":"valid","value":"やすもう"},"causative":{"status":"valid","value":"やすませる","note":"Keep the physical-rest meaning explicit and separate from taking leave from work."}}},
    "minna-shokyu-1-group-1-080": {"dictionary":"やすむ（しごとを）","kanji":"休む（仕事を）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"やすまなかった"},"potential":{"status":"valid","value":"やすめる"},"ba":{"status":"valid","value":"やすめば"},"volitional":{"status":"valid","value":"やすもう"},"causative":{"status":"valid","value":"やすませる","note":"Keep work or the workplace explicit so this remains distinct from physical rest."}}},
    "minna-shokyu-1-group-1-081": {"dictionary":"わたる（はしを）","kanji":"渡る（橋を）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"わたらなかった"},"potential":{"status":"valid","value":"わたれる","note":"Keep the bridge and crossing conditions explicit so the potential meaning is clear."},"ba":{"status":"valid","value":"わたれば"},"volitional":{"status":"valid","value":"わたろう"},"causative":{"status":"valid","value":"わたらせる","note":"Identify the person managing safety, the person crossing, and the bridge or destination."}}},
    "minna-shokyu-1-group-2-001": {"dictionary":"あける","kanji":"開ける","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"あけなかった"},"potential":{"status":"valid","value":"あけられる"},"ba":{"status":"valid","value":"あければ"},"volitional":{"status":"valid","value":"あけよう"},"causative":{"status":"valid","value":"あけさせる"}}},
    "minna-shokyu-1-group-2-002": {"dictionary":"あげる","kanji":"あげる","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"あげなかった"},"potential":{"status":"valid","value":"あげられる","note":"The surface form can also be passive; keep the giver's ability and recipient explicit."},"ba":{"status":"valid","value":"あげれば"},"volitional":{"status":"valid","value":"あげよう"},"causative":{"status":"valid","value":"あげさせる"}}},
    "minna-shokyu-1-group-2-003": {"dictionary":"あつめる","kanji":"集める","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"あつめなかった"},"potential":{"status":"valid","value":"あつめられる"},"ba":{"status":"valid","value":"あつめれば"},"volitional":{"status":"valid","value":"あつめよう"},"causative":{"status":"valid","value":"あつめさせる"}}},
    "minna-shokyu-1-group-2-004": {"dictionary":"あびる（シャワーを）","kanji":"浴びる（シャワーを）","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"あびなかった"},"potential":{"status":"valid","value":"あびられる"},"ba":{"status":"valid","value":"あびれば"},"volitional":{"status":"valid","value":"あびよう"},"causative":{"status":"valid","value":"あびさせる"}}},
    "minna-shokyu-1-group-2-005": {"dictionary":"いる","kanji":"居る","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"いなかった"},"potential":{"status":"deferred","note":"For the source sense of animate existence, いられる ordinarily shifts toward being able to stay or being allowed to keep an animal. Excluded from production by user decision."},"ba":{"status":"valid","value":"いれば"},"volitional":{"status":"deferred","note":"いよう ordinarily expresses an animate subject's intention to stay, not simple existence. Excluded from this lexical entry by user decision."},"causative":{"status":"deferred","note":"いさせる means make or let someone remain and does not preserve the source sense of simple animate existence. Excluded by user decision."}}},
    "minna-shokyu-1-group-2-006": {"dictionary":"いる","kanji":"居る","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"いなかった"},"potential":{"status":"deferred","note":"いられる does not ordinarily express the ability to have a child in the source construction. Excluded from production by user decision."},"ba":{"status":"valid","value":"いれば"},"volitional":{"status":"deferred","note":"いよう shifts to an intention to remain somewhere and does not preserve the source possession construction. Excluded by user decision."},"causative":{"status":"deferred","note":"いさせる means make or let someone remain and does not preserve the source construction meaning have a child. Excluded by user decision."}}},
    "minna-shokyu-1-group-2-007": {"dictionary":"いる","kanji":"居る","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"いなかった"},"potential":{"status":"valid","value":"いられる","note":"Keep a place and condition or duration explicit so this is read as ability to stay."},"ba":{"status":"valid","value":"いれば"},"volitional":{"status":"valid","value":"いよう","note":"Keep a place and intended duration explicit."},"causative":{"status":"valid","value":"いさせる","note":"Identify the person or organization permitting the stay, the person staying, and the place."}}},
    "minna-shokyu-1-group-2-008": {"dictionary":"いれる","kanji":"入れる","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"いれなかった"},"potential":{"status":"valid","value":"いれられる","note":"Keep the container and inserted object explicit so the potential meaning is clear."},"ba":{"status":"valid","value":"いれれば"},"volitional":{"status":"valid","value":"いれよう"},"causative":{"status":"valid","value":"いれさせる","note":"Identify the causer, person inserting the object, object, and destination."}}},
    "minna-shokyu-1-group-2-009": {"dictionary":"うまれる","kanji":"生まれる","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"うまれなかった"},"potential":{"status":"deferred","note":"A natural beginner example for 生まれられる is difficult to keep within the source meaning and tends to require abstract counterfactual context."},"ba":{"status":"valid","value":"うまれれば"},"volitional":{"status":"deferred","note":"Being born is not ordinarily a volitional act, so うまれよう is excluded from beginner production."},"causative":{"status":"deferred","note":"Ordinary causative contexts generally use 産ませる or another lexical construction; 生まれさせる is excluded pending later contextual review."}}},
    "minna-shokyu-1-group-2-010": {"dictionary":"おきる","kanji":"起きる","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"おきなかった"},"potential":{"status":"valid","value":"おきられる"},"ba":{"status":"valid","value":"おきれば"},"volitional":{"status":"valid","value":"おきよう"},"causative":{"status":"valid","value":"おきさせる","note":"Keep waking or getting up explicit so this is not confused with 起こす."}}},
    "minna-shokyu-1-group-2-011": {"dictionary":"おしえる","kanji":"教える","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"おしえなかった"},"potential":{"status":"valid","value":"おしえられる"},"ba":{"status":"valid","value":"おしえれば"},"volitional":{"status":"valid","value":"おしえよう"},"causative":{"status":"valid","value":"おしえさせる","note":"Keep the teaching content, learner, and person assigning the teaching explicit."}}},
    "minna-shokyu-1-group-2-012": {"dictionary":"おしえる","kanji":"教える","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"おしえなかった"},"potential":{"status":"valid","value":"おしえられる"},"ba":{"status":"valid","value":"おしえれば"},"volitional":{"status":"valid","value":"おしえよう"},"causative":{"status":"valid","value":"おしえさせる","note":"Keep the information being disclosed explicit so this remains distinct from teaching."}}},
    "minna-shokyu-1-group-2-013": {"dictionary":"おぼえる","kanji":"覚える","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"おぼえなかった"},"potential":{"status":"valid","value":"おぼえられる"},"ba":{"status":"valid","value":"おぼえれば"},"volitional":{"status":"valid","value":"おぼえよう"},"causative":{"status":"valid","value":"おぼえさせる","note":"Identify the person assigning the memorization and the learner."}}},
    "minna-shokyu-1-group-2-014": {"dictionary":"おりる","kanji":"降りる","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"おりなかった"},"potential":{"status":"valid","value":"おりられる","note":"Keep a vehicle, station, or stop explicit so the potential meaning is clear."},"ba":{"status":"valid","value":"おりれば"},"volitional":{"status":"valid","value":"おりよう"},"causative":{"status":"valid","value":"おりさせる","note":"Identify who permits or directs the passenger to get off and where."}}},
    "minna-shokyu-1-group-2-015": {"dictionary":"かえる","kanji":"換える","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"かえなかった"},"potential":{"status":"valid","value":"かえられる","note":"Keep both currencies explicit so this remains distinct from 変える."},"ba":{"status":"valid","value":"かえれば"},"volitional":{"status":"valid","value":"かえよう"},"causative":{"status":"valid","value":"かえさせる","note":"Use a clear currency-exchange context and identify the manager and clerk."}}},
    "minna-shokyu-1-group-2-016": {"dictionary":"かえる","kanji":"変える","confidence":"high","sources":[{"type":"reference-index","name":"国立国語研究所 基本動詞ハンドブック","url":"https://www2.ninjal.ac.jp/verbhandbook/"}],"forms":{"pastNegative":{"status":"valid","value":"かえなかった"},"potential":{"status":"valid","value":"かえられる","note":"Keep a plan, time, method, or other changed item explicit so this remains distinct from currency exchange."},"ba":{"status":"valid","value":"かえれば"},"volitional":{"status":"valid","value":"かえよう"},"causative":{"status":"valid","value":"かえさせる","note":"Identify the decision-maker, person making the change, and plan or schedule being changed."}}},
